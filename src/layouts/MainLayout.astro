---
import "../styles/main.css";
import Ad from "../components/ad.astro";
import CookieConsent from "../components/CookieConsent.astro";
import CaptchaDialog from "../components/CaptchaDialog.astro";
import LstwoMods from "../components/LstwoMods.astro";
import VideoAd from "../components/Video.astro";
import type { VideoAdDefinition } from "../components/Video.astro";

const { title = "Graded F" } = Astro.props;

const ads = [
    { image: "/images/gabent ad.webp", link: "https://gabtinte.com" },
    { image: "/images/djpts1ad.webp", link: "https://djpt.rinny.net/" },
    { image: "/images/tristanad.webp", link: "https://www.tkplumbing.ca/plumbing-repair-and-maintenance" },
    { image: "/images/lstwomodsad.webp", link: "https://lstwomods.com" },
    { image: "/images/djpts2ad.webp", link: "https://djpt.rinny.net/" },
    { image: "/images/mazead.webp", link: "https://www.proprofs.com/quiz-school/story.php?title=are-you-smarter-than-2nd-grader" },
    { image: "/images/foxad.webp", link: "https://www.youtube.com/playlist?list=PLHovnlOusNLgvAbnxluXCVB3KLj8e4QB-" },
    { image: "/images/townsvillead.webp", link: "https://youtube.com/@Townsville-News" },
    { image: "/images/bskyad.webp", link: "https://bsky.app", link2: "https://x.com", delay: 10_000 },
    { image: "/images/rbgad.webp", link: "https://rooberbandgames.com" },
    { image: "/images/gabad.webp", link: "https://www.gov.il/en" },
    { image: "/images/adobe ad.webp", link: "https://adobe.com" },
    { image: "/images/caead1.webp", link: "https://caethecow.com" },
    { image: "/images/superfuckingmario.comad.webp", link: "https://superfuckingmario.com" },
];

const bannerAds = [
    { image: "/images/lstwoMODS AD 2.png", link: "https://lstwomods.com", no_icons: true },
    { image: "/images/rinnyad.webp", link: "https://rinny.net", no_icons: true },
    { image: "/images/jackad.webp", link: "https://youtube.com/@the3richwobblies", no_icons: true },
    { image: "/images/anothergradedfad.webp", link: "https://www.youtube.com/@GradedF/community", no_icons: true },
    { image: "/images/claudead.webp", link: "https://claude.ai", no_icons: true },
    { image: "/images/blenderad.webp", link: "https://blender.org", no_icons: true },
    { image: "/images/chatgptad.webp", link: "https://chatgpt.com", no_icons: true },
    { image: "/images/gdad.webp", link: "https://geometrydash.com", no_icons: true },
];

const videoAds: VideoAdDefinition[] = [
    { src: "/videos/ads/windowsad.mp4", link: "https://www.microsoft.com/windows" },
    { src: "/videos/ads/windowsad2.mp4", link: "https://www.microsoft.com/windows" },
    { src: "/videos/ads/windowsad3.mp4", link: "https://www.microsoft.com/windows", skipAfter: 15 },
    { src: "/videos/ads/googlead1.mp4", link: "https://google.com", skipAfter: 20 },
    { src: "/videos/ads/mediamarktad1.mp4", link: "https://mediamarkt.de", skipAfter: 15 },
    { src: "/videos/ads/laptopad1.mp4", link: "https://www.lenovo.com/de/de/p/laptops/legion-laptops/legion-9-series/legion-9i-gen-10-18-inch-intel/83eycto1wwde1", skipAfter: 15 },
    { src: "/videos/ads/mcdonaldsad1.mp4", link: "https://mcdonalds.com", skipAfter: 15 },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
</head>

<body>

<LstwoMods />
<CookieConsent />
<CaptchaDialog />
<VideoAd ads={videoAds} />

<marquee class="watermark" behavior="alternate" direction="right">
    <marquee behavior="alternate" direction="down">
        Graded F
    </marquee>
</marquee>

<div class="page-layout">

<div class="left-sidebar" id="ad-slot-left">
    <div class="sidebar-ad-slot"></div>
    <div class="sidebar-ad-slot"></div>
</div>

<div style="display: flex; flex-direction: column;">
    <header class="main-page-block">
        <a href="/">Home</a>
    </header>

    <main class="main-page-block">
        <div id="ad-slot-banner" style="width: 100%; margin-top: 16px;"></div>

        <slot />
    </main>

    <footer class="main-page-block">
        <a href="https://steamcommunity.com/groups/gradedf">Steam Group</a>
        <a href="https://youtube.com/@GradedF">YouTube Channel</a>
        <a href="https://discord.gg/8BDnYSbaUB">Discord Server</a>
    </footer>
</div>

<div class="right-sidebar" id="ad-slot-right">
    <div class="sidebar-ad-slot"></div>
    <div class="sidebar-ad-slot"></div>
</div>

<template id="ad-pool" hidden>
    {ads.map(ad => <Ad {...ad} />)}
</template>

<template id="banner-ad-pool" hidden>
    {bannerAds.map(ad => <Ad {...ad} />)}
</template>

<script>
    import { refreshAd, initAdRedirects } from "../scripts/ad";
    initAdRedirects();
    
    const sidebarIntervals = [5_091, 6_205, 5_683, 6_917];

    document.querySelectorAll<HTMLElement>(".sidebar-ad-slot").forEach((slot, i) => {
        refreshAd(slot);
        setInterval(() => refreshAd(slot), sidebarIntervals[i % sidebarIntervals.length]);
    });

    let adSlotBanner = document.querySelector<HTMLElement>("#ad-slot-banner");

    if (adSlotBanner) {
        refreshAd(adSlotBanner, "banner-ad-pool");
        setInterval(() => refreshAd(adSlotBanner, "banner-ad-pool"), 7_333);
    }
</script>

<style>
    .watermark {
        position: absolute;
        z-index: -1;
        color: rgba(255, 255, 255, 0.5);
        width: 100vw;
        height: 100vh;
        top: 0;
        left: 0;
    }

    .watermark marquee {
        height: 100vh;
        width: fit-content;
    }
</style>

</div>
</body>
</html>
