---
import MainLayout from '../layouts/MainLayout.astro'
import { getCollection } from "astro:content";

const reviews = await getCollection("reviews");
---

<MainLayout title="Home - Graded F">
    <h1>Welcome to Graded F!</h1>

    We make professional videos and game reviews!

	<h2>Reviews:</h2>

	<ul>
		{reviews.map(review => (
			<li><a href={`/reviews/${review.id}`}>{review.data.game_title}</a></li>
		))}
	</ul>
</MainLayout>
