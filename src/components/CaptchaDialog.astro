---
import Captcha from "./Captcha.astro";
import type { CaptchaDefinition } from "./Captcha.astro";

const roadImages = [
    { src: "/images/captcha/road1.webp", match: false },
    { src: "/images/captcha/road2.webp", match: true },
    { src: "/images/captcha/road3.webp", match: false },
    { src: "/images/captcha/road4.webp", match: true },
    { src: "/images/captcha/road5.webp", match: false },
    { src: "/images/captcha/road6.webp", match: true },
    { src: "/images/captcha/road7.webp", match: false },
    { src: "/images/captcha/road8.webp", match: false },
    { src: "/images/captcha/road9.webp", match: false },
    { src: "/images/captcha/road10.webp", match: false },
    { src: "/images/captcha/road11.webp", match: true },
    { src: "/images/captcha/road12.webp", match: true },
    { src: "/images/captcha/road13.webp", match: true },
];

const trafficLightImages = [
    { src: "/images/captcha/trafficlight1.webp", squares: [5, 6, 9, 10, 13] },
    { src: "/images/captcha/trafficlight2.webp", squares: [2, 6, 10, 14] },
];

const wordImages = [
    { src: "/images/captcha/word1.webp", word: "mazaniel" },
    { src: "/images/captcha/word2.webp", word: "labyrinth" },
    { src: "/images/captcha/word3.webp", word: "three" },
    { src: "/images/captcha/word4.webp", word: "enterprise" },
    { src: "/images/captcha/word5.webp", word: "Tristan's Pipe Repairs" },
    { src: "/images/captcha/word6.webp", word: "Graded F" },
];

const ytbersImages = [
    { src: "/images/captcha/yt1.jpg", match: false },
    { src: "/images/captcha/yt2.jpg", match: false },
    { src: "/images/captcha/yt3.jpg", match: false },
    { src: "/images/captcha/yt4.jpg", match: false },
    { src: "/images/captcha/yt5.jpg", match: true },
    { src: "/images/captcha/yt6.jpg", match: false },
    { src: "/images/captcha/yt7.jpg", match: false },
    { src: "/images/captcha/yt8.jpg", match: false },
    { src: "/images/captcha/yt9.png", match: false },
]

const audioClips = [
    { src: "/audio/captcha/audiocaptcha1.mp3", question: "How big is cae's forehead?", answers: ["30cm", "30 cm", "thirty cm", "30 centimeters", "thirty centimeters", "idk"] },
];

const captchas: CaptchaDefinition[] = [
    { type: "select", target: "motorcycles", images: roadImages },
    { type: "replace", target: "motorcycles", images: roadImages },
    { type: "squares", target: "traffic lights", images: trafficLightImages },
    { type: "text", target: "two words", images: wordImages },
    { type: "select", target: "good youtubers", images: ytbersImages },
    { type: "audio", target: "the question", images: audioClips },
];
---

<dialog class="captcha-dialog">
    <span style="font-size: x-large;">Verify you are human</span> <br> <br>
    to continue to the Graded F website please prove you are not a robot <br> <br>

    <Captcha captchas={captchas} />
</dialog>

<script>
    const STORAGE_KEY = "captcha-solved";

    const dialog = document.querySelector<HTMLDialogElement>(".captcha-dialog");
    const cookieConsent = document.querySelector<HTMLDialogElement>(".cookie-consent");

    function openCaptcha() {
        const lastCaptcha = Number(localStorage.getItem(STORAGE_KEY));
        
        if (!dialog || Date.now() - lastCaptcha < 1 * 60 * 1000) return;

        if (cookieConsent?.open) {
            cookieConsent.addEventListener("close", openCaptcha, { once: true });
            return;
        }

        dialog.showModal();
    }

    if (dialog) {
        dialog.addEventListener("cancel", (event: Event) => event.preventDefault());

        dialog.addEventListener("captcha-solved", () => {
            localStorage.setItem(STORAGE_KEY, Date.now().toString());
            setTimeout(() => dialog.close(), 800);
        });

        openCaptcha();
    }
</script>

<style>
    .captcha-dialog {
        background-color: white;
        border: 4px outset;
        color: black;
        padding: 24px;
        outline: 4px solid black;
    }

    .captcha-dialog::backdrop {
        background-color: rgba(0, 0, 0, 0.75);
    }

    .captcha-dialog :global(.captcha-popup) {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }
</style>
