---
interface CaptchaImage {
    src: string;
    motorcycle?: boolean;
    trafficLightSquares?: number[];
}

interface Props {
    images: CaptchaImage[];
    rounds?: number;
    label?: string;
}

const { images, rounds = 2, label = "I'm not a robot" } = Astro.props;
---

<div class="captcha" data-images={JSON.stringify(images)} data-rounds={rounds}>
    <button class="captcha-anchor" type="button">
        <span class="captcha-checkbox"></span>
        <span class="captcha-label">{label}</span>
    </button>

    <div class="captcha-branding">
        <span class="captcha-logo">↻</span>
        <span>gradedCAPTCHA</span>
        <small>Privacy - Terms</small>
    </div>

    <div class="captcha-popup" hidden>
        <div class="captcha-header">
            <span class="captcha-prompt"></span>
            <strong class="captcha-target"></strong>
            <span class="captcha-instructions"></span>
        </div>

        <div class="captcha-grid"></div>

        <p class="captcha-error" hidden>Please try again.</p>

        <div class="captcha-footer">
            <button class="captcha-reload" type="button" title="Get a new challenge">↻</button>
            <button class="captcha-verify" type="button">Verify</button>
        </div>
    </div>
</div>

<script>
    type CaptchaImage = {
        src: string;
        motorcycle?: boolean;
        trafficLightSquares?: number[];
    };

    type Challenge = {
        target: string;
        gridSize: number;
        images?: CaptchaImage[];
        image?: CaptchaImage;
        replacesTiles?: boolean;
    };

    const FADE_OUT_MS = 300;
    const FADE_IN_MS = 4000;

    function shuffle<T>(items: T[]) {
        const shuffled = [...items];

        for (let i = shuffled.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
        }

        return shuffled;
    }

    function randomItem<T>(items: T[]) {
        return items[Math.floor(Math.random() * items.length)];
    }

    function createMotorcycleChallenge(roadImages: CaptchaImage[]): Challenge {
        return {
            target: "motorcycles",
            gridSize: 3,
            images: shuffle(roadImages).slice(0, 9),
            replacesTiles: Math.random() < 0.5,
        };
    }

    function createTrafficLightChallenge(trafficLightImages: CaptchaImage[]): Challenge {
        return {
            target: "traffic lights",
            gridSize: 4,
            image: randomItem(trafficLightImages),
        };
    }

    function createRandomChallenge(roadImages: CaptchaImage[], trafficLightImages: CaptchaImage[]) {
        if (roadImages.length === 0) return createTrafficLightChallenge(trafficLightImages);
        if (trafficLightImages.length === 0) return createMotorcycleChallenge(roadImages);

        return Math.random() < 0.5
            ? createMotorcycleChallenge(roadImages)
            : createTrafficLightChallenge(trafficLightImages);
    }

    function setupCaptcha(root: HTMLElement) {
        const images: CaptchaImage[] = JSON.parse(root.dataset.images ?? "[]");
        const rounds = Number(root.dataset.rounds ?? 1);

        const roadImages = images.filter(image => image.motorcycle !== undefined);
        const trafficLightImages = images.filter(image => image.trafficLightSquares !== undefined);

        const anchor = root.querySelector<HTMLButtonElement>(".captcha-anchor")!;
        const popup = root.querySelector<HTMLElement>(".captcha-popup")!;
        const prompt = root.querySelector<HTMLElement>(".captcha-prompt")!;
        const target = root.querySelector<HTMLElement>(".captcha-target")!;
        const instructions = root.querySelector<HTMLElement>(".captcha-instructions")!;
        const grid = root.querySelector<HTMLElement>(".captcha-grid")!;
        const error = root.querySelector<HTMLElement>(".captcha-error")!;
        const reloadButton = root.querySelector<HTMLButtonElement>(".captcha-reload")!;
        const verifyButton = root.querySelector<HTMLButtonElement>(".captcha-verify")!;

        let challenge: Challenge;
        let solvedRounds = 0;
        let madeMistake = false;
        const selectedTiles = new Set<number>();

        function setTileBackground(tileImage: HTMLElement, index: number) {
            const { gridSize } = challenge;

            if (challenge.image) {
                const row = Math.floor(index / gridSize);
                const column = index % gridSize;
                const step = 100 / (gridSize - 1);

                tileImage.style.backgroundImage = `url("${challenge.image.src}")`;
                tileImage.style.backgroundSize = `${gridSize * 100}% ${gridSize * 100}%`;
                tileImage.style.backgroundPosition = `${column * step}% ${row * step}%`;
            } else {
                tileImage.style.backgroundImage = `url("${challenge.images![index].src}")`;
            }
        }

        function pickReplacementImage() {
            const unused = roadImages.filter(image => !challenge.images!.includes(image));
            return randomItem(unused.length > 0 ? unused : roadImages);
        }

        function replaceTile(tile: HTMLElement, tileImage: HTMLElement, index: number) {
            if (!challenge.images![index].motorcycle) madeMistake = true;

            challenge.images![index] = pickReplacementImage();
            tile.classList.add("fading-out");

            setTimeout(() => {
                setTileBackground(tileImage, index);
                tile.classList.replace("fading-out", "fading-in");
            }, FADE_OUT_MS);

            setTimeout(() => tile.classList.remove("fading-in"), FADE_OUT_MS + FADE_IN_MS);
        }

        function toggleTile(tile: HTMLElement, index: number) {
            if (selectedTiles.has(index)) selectedTiles.delete(index);
            else selectedTiles.add(index);

            tile.classList.toggle("selected", selectedTiles.has(index));
        }

        function createTile(index: number) {
            const tile = document.createElement("button");
            const tileImage = document.createElement("span");

            tile.type = "button";
            tile.className = "captcha-tile";
            tileImage.className = "captcha-tile-image";
            setTileBackground(tileImage, index);

            tile.addEventListener("click", () => {
                error.hidden = true;

                if (challenge.replacesTiles) replaceTile(tile, tileImage, index);
                else toggleTile(tile, index);
            });

            tile.append(tileImage);
            return tile;
        }

        function showNewChallenge() {
            challenge = createRandomChallenge(roadImages, trafficLightImages);

            const tileCount = challenge.image ? challenge.gridSize ** 2 : challenge.images!.length;

            madeMistake = false;
            selectedTiles.clear();
            error.hidden = true;

            prompt.textContent = challenge.image ? "Select all squares with" : "Select all images with";
            target.textContent = challenge.target;
            instructions.textContent = challenge.replacesTiles
                ? "Click verify once there are none left."
                : "If there are none, click verify.";

            grid.style.setProperty("--fade-in-duration", `${FADE_IN_MS}ms`);
            grid.style.gridTemplateColumns = `repeat(${challenge.gridSize}, 1fr)`;
            grid.replaceChildren(...Array.from({ length: tileCount }, (_, index) => createTile(index)));
        }

        function getAnswer() {
            if (challenge.image) return challenge.image.trafficLightSquares!;

            return challenge.images!.flatMap((image, index) => (image.motorcycle ? [index] : []));
        }

        function isCorrect() {
            if (challenge.replacesTiles) {
                return !madeMistake && !challenge.images!.some(image => image.motorcycle);
            }

            const answer = new Set(getAnswer());
            return answer.size === selectedTiles.size && [...answer].every(index => selectedTiles.has(index));
        }

        function finish() {
            popup.hidden = true;
            root.classList.remove("loading");
            root.classList.add("solved");
            root.dispatchEvent(new CustomEvent("captcha-solved", { bubbles: true }));
        }

        anchor.addEventListener("click", () => {
            if (root.classList.contains("solved") || !popup.hidden) return;

            root.classList.add("loading");

            setTimeout(() => {
                solvedRounds = 0;
                showNewChallenge();
                popup.hidden = false;
            }, 600);
        });

        reloadButton.addEventListener("click", showNewChallenge);

        verifyButton.addEventListener("click", () => {
            if (!isCorrect()) {
                showNewChallenge();
                error.hidden = false;
                return;
            }

            solvedRounds++;

            if (solvedRounds < rounds) showNewChallenge();
            else finish();
        });
    }

    document.querySelectorAll<HTMLElement>(".captcha").forEach(setupCaptcha);
</script>

<style is:global>
    .captcha {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 304px;
        height: 78px;
        padding: 0 12px;
        box-sizing: border-box;
        background: #f9f9f9;
        border: 1px solid #d3d3d3;
        border-radius: 3px;
        box-shadow: 0 0 4px rgba(0, 0, 0, 0.08);
        font-family: Roboto, Arial, sans-serif;
        color: #000;
    }

    .captcha-anchor {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 0;
        background: none;
        border: none;
        font: inherit;
        font-size: 14px;
        cursor: pointer;
    }

    .captcha-checkbox {
        position: relative;
        width: 24px;
        height: 24px;
        background: #fff;
        border: 2px solid #c1c1c1;
        border-radius: 2px;
    }

    .captcha-anchor:hover .captcha-checkbox {
        border-color: #b2b2b2;
    }

    .captcha.loading .captcha-checkbox {
        border: 4px solid #4a90e2;
        border-top-color: transparent;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        animation: captcha-spin 0.8s linear infinite;
    }

    .captcha.solved .captcha-checkbox {
        border: none;
        background: none;
    }

    .captcha.solved .captcha-checkbox::after {
        content: "";
        position: absolute;
        left: 8px;
        top: -2px;
        width: 9px;
        height: 20px;
        border: solid #009e55;
        border-width: 0 4px 4px 0;
        transform: rotate(45deg);
    }

    .captcha-branding {
        display: flex;
        flex-direction: column;
        align-items: center;
        font-size: 10px;
        color: #555;
    }

    .captcha-logo {
        font-size: 26px;
        line-height: 1;
        color: #4a90e2;
    }

    .captcha-branding small {
        font-size: 8px;
    }

    .captcha-popup {
        position: absolute;
        top: 0;
        left: calc(100% + 10px);
        z-index: 10;
        width: 400px;
        padding: 8px;
        box-sizing: border-box;
        background: #fff;
        border: 1px solid #ccc;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    }

    .captcha-popup[hidden] {
        display: none;
    }

    .captcha-header {
        display: flex;
        flex-direction: column;
        padding: 20px 16px;
        background: #4a90e2;
        color: #fff;
        font-size: 14px;
    }

    .captcha-target {
        font-size: 24px;
        line-height: 1.3;
    }

    .captcha-grid {
        display: grid;
        gap: 4px;
        margin-top: 8px;
    }

    .captcha-tile {
        position: relative;
        aspect-ratio: 1;
        padding: 0;
        background: #f0f0f0;
        border: none;
        cursor: pointer;
    }

    .captcha-tile-image {
        display: block;
        width: 100%;
        height: 100%;
        background-size: cover;
        background-position: center;
        transition: transform 0.1s, opacity 0.3s;
    }

    .captcha-tile.fading-out,
    .captcha-tile.fading-in {
        pointer-events: none;
    }

    .captcha-tile.fading-out .captcha-tile-image {
        opacity: 0;
    }

    .captcha-tile.fading-in .captcha-tile-image {
        transition: opacity var(--fade-in-duration) ease-in;
    }

    .captcha-tile.selected .captcha-tile-image {
        transform: scale(0.8);
    }

    .captcha-tile.selected::before {
        content: "✓";
        position: absolute;
        top: 2px;
        left: 2px;
        z-index: 1;
        display: grid;
        place-items: center;
        width: 22px;
        height: 22px;
        background: #4a90e2;
        border-radius: 50%;
        color: #fff;
        font-size: 14px;
    }

    .captcha-error {
        margin: 8px 0 0;
        color: #d00;
        font-size: 13px;
    }

    .captcha-error[hidden] {
        display: none;
    }

    .captcha-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 8px;
        padding-top: 8px;
        border-top: 1px solid #dfdfdf;
    }

    .captcha-reload {
        padding: 0 8px;
        background: none;
        border: none;
        color: #555;
        font-size: 24px;
        cursor: pointer;
    }

    .captcha-verify {
        padding: 10px 24px;
        background: #4a90e2;
        border: none;
        border-radius: 2px;
        color: #fff;
        font: inherit;
        font-weight: bold;
        text-transform: uppercase;
        cursor: pointer;
    }

    .captcha-verify:hover {
        background: #3b7fd0;
    }

    @keyframes captcha-spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>
