---
const { image, link, link2, delay, no_icons } = Astro.props;
const useRedirect = Boolean(link2 && delay != null);
---

<div class="ad">
    <a href={link} target="_blank" class={useRedirect ? "redirect-link" : "ad-link"} data-link2={link2} data-delay={delay}>
        <img src={image} alt="ad">
    </a>

    {!no_icons && (
        <div class="ad-icons">
            <img src="/images/adchoices.svg" alt="">
            <img src="/images/threedotsidk.svg" alt="">
        </div>
    )}
</div>

<style>
    .ad {
        position: relative;
        width: 100%;
    }

    .ad > a > img {
        display: block;
        width: 100%;
        height: auto;
    }

    .ad-icons {
        position: absolute;
        top: 4px;
        right: 4px;
        display: flex;
        gap: 6px;
        z-index: 1;
    }

    .ad-icons img {
        width: 24px;
        height: 24px;
    }
</style>